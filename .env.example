# ==========================================================================
# Aplikasi
# ==========================================================================
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
TZ=Asia/Jakarta

# ==========================================================================
# PostgreSQL
# ==========================================================================
POSTGRES_USER=healthcare_user
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=healthcare_facility_dashboard
POSTGRES_PORT=5432

# Dipakai Prisma. Host "postgres" mengacu ke nama service di docker-compose.
DATABASE_URL=postgresql://healthcare_user:ganti_password_ini@postgres:5432/healthcare_facility_dashboard?schema=public

# ==========================================================================
# MinIO (object storage foto dokter)
# ==========================================================================
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=ganti_password_ini
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Endpoint internal (dipakai server Next.js untuk komunikasi ke MinIO)
MINIO_ENDPOINT=http://minio:9000
# Endpoint publik (dipakai untuk membangun URL foto yang diakses browser pasien).
# - Development (docker-compose.yml): http://localhost:9000
# - Production (docker-compose.prod.yml): https://domain-anda.com/storage
#   (Nginx men-proxy path /storage/ ke MinIO -- lihat docker/nginx/nginx.prod.conf,
#   supaya MinIO tidak perlu punya domain/port publik sendiri)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=healthcare-facility-dashboard

# ==========================================================================
# Session admin
# ==========================================================================
SESSION_COOKIE_NAME=hfd_session
SESSION_MAX_AGE_DAYS=7

# ==========================================================================
# Upload foto dokter
# ==========================================================================
MAX_PHOTO_SIZE_MB=2
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ==========================================================================
# Informasi fasilitas (nilai awal, bisa diubah lewat panel admin)
# ==========================================================================
FACILITY_NAME=Klinik Sehat Sentosa
FACILITY_TIMEZONE=Asia/Jakarta

# ==========================================================================
# Production (Nginx + Certbot)
# ==========================================================================
DOMAIN=contoh-domain-anda.com
CERTBOT_EMAIL=admin@contoh-domain-anda.com
# Set ke 1 sementara saat pertama kali uji coba docker/init-letsencrypt.sh --
# server staging Let's Encrypt tidak kena batas jumlah permintaan per minggu,
# tapi sertifikatnya tidak dipercaya browser. Kembalikan ke 0 untuk sertifikat asli.
CERTBOT_STAGING=0
